<Window x:Class="DeckPilot.Factory.ResetConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Effacer le firmware de la carte"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        Foreground="#F0F4F2" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Cette opération rendra la carte temporairement invisible" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <Border Grid.Row="1" Background="#33251B" BorderBrush="#76512C" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,16,0,14">
      <StackPanel>
        <TextBlock Text="Le firmware DeckPilot et l’envoi des touches F13–F24 seront effacés. Après l’opération, Windows et Atelier ne verront plus la carte comme un clavier." TextWrapping="Wrap"/>
        <TextBlock Text="Pour la récupérer, garde-la branchée, relie brièvement les contacts RST et GND deux fois rapidement, puis sélectionne le port Arduino Leonardo / bootloader dans Atelier et réinstalle le firmware. Le bootloader Caterina et l’EEPROM restent intacts." TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2">
      <TextBlock Text="Pour confirmer l’effacement, tape exactement EFFACER :" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
      <TextBox x:Name="ConfirmationInput" AutomationProperties.AutomationId="ResetConfirmationInput" Height="36" Padding="8,5" TextChanged="ConfirmationInput_TextChanged"/>
    </StackPanel>
    <DockPanel Grid.Row="3" Margin="0,18,0,0" LastChildFill="False">
      <Button Content="Annuler" IsCancel="True" MinWidth="100" Padding="14,8" DockPanel.Dock="Right" Margin="8,0,0,0"/>
      <Button x:Name="EraseButton" Content="Effacer le firmware" IsDefault="True" IsEnabled="False" MinWidth="150" Padding="14,8" DockPanel.Dock="Right" Click="EraseButton_Click"/>
    </DockPanel>
  </Grid>
</Window>
