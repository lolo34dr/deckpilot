<Window x:Class="DeckPilot.Factory.UpdatePromptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mise à jour DeckPilot Atelier" Width="500" SizeToContent="Height" ResizeMode="NoResize" Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Une mise à jour est disponible" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock x:Name="ChangesText" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,14" TextWrapping="Wrap"/>
      <TextBlock Text="L’installeur met à jour Atelier et le firmware inclus. Après la mise à jour de l’application, tu pourras choisir quand flasher la carte." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
      <TextBlock x:Name="SizeText" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,20,0,0">
      <TextBlock x:Name="DownloadStatus" TextWrapping="Wrap"/>
      <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0" Maximum="100" Margin="0,10,0,0" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Background="{StaticResource Panel2Brush}" BorderThickness="0"/>
      <TextBlock x:Name="ErrorText" Foreground="#F2A6A6" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button x:Name="LaterButton" Content="Plus tard" Click="Later_Click"/>
      <Button x:Name="InstallButton" Content="Télécharger et installer" Background="#186950" BorderBrush="#277C62" Click="Install_Click" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
