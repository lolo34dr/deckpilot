<Window x:Class="DeckPilot.Factory.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeckPilot Atelier" Width="1060" Height="760" MinWidth="900" MinHeight="680" Background="{StaticResource BgBrush}" Foreground="#F0F4F2" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,22"><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource Panel2Brush}" Margin="0,0,12,0"><TextBlock Text="✦" Foreground="{StaticResource AccentBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="DeckPilot Atelier" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Préparation et contrôle qualité des macropads" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel></StackPanel><Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="12,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#8B9691" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionLabel" Text="Carte non détectée" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border></DockPanel>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="8" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="FlashTab" Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="14,10" MouseLeftButtonUp="FlashTab_Click"><TextBlock Text="1  ·  Installer le firmware" HorizontalAlignment="Center" FontWeight="SemiBold"/></Border><Border x:Name="TestTab" Grid.Column="1" CornerRadius="10" Padding="14,10" MouseLeftButtonUp="TestTab_Click"><TextBlock Text="2  ·  Tester les touches" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></Border></Grid></Border>
    <Grid Grid.Row="2"><Grid x:Name="FlashPage"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width=".9*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,16,0"><StackPanel><TextBlock Text="Préparer une carte" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Branche le macropad en USB-C. L’outil reconnaît le bootloader Arduino Leonardo / ATmega32U4." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,20"/><Border Background="#17211E" CornerRadius="12" Padding="16" Margin="0,0,0,18"><StackPanel><TextBlock Text="CARTE SÉLECTIONNÉE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/><ComboBox x:Name="DeviceCombo" Margin="0,10,0,0" Height="38" Background="{StaticResource Panel2Brush}" Foreground="#F0F4F2" BorderBrush="{StaticResource LineBrush}" SelectionChanged="DeviceCombo_SelectionChanged"/></StackPanel></Border><Button x:Name="FlashButton" Content="Installer le firmware DeckPilot" Background="#186950" BorderBrush="#277C62" Click="FlashButton_Click"/><ProgressBar x:Name="FlashProgress" Height="5" Margin="0,16,0,10" IsIndeterminate="False" Visibility="Collapsed"/><TextBlock x:Name="FlashStatus" Text="Le firmware est vérifié avant l’écriture. Le bootloader reste intact." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/><Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="12" Margin="0,20,0,0"><TextBlock Text="Pendant le flash, ne débranche pas le câble. L’application vérifie l’écriture puis attend le redémarrage de la carte." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/></Border></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="24"><StackPanel><TextBlock Text="Compatible avec" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Arduino Leonardo / Pro Micro" FontSize="16"/><TextBlock Text="ATmega32U4 · USB-C · bootloader Caterina" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/><Separator Background="{StaticResource LineBrush}"/><TextBlock Text="Ce que fait l’installateur" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,12"/><TextBlock Text="✓  Identifie le périphérique USB exact" Margin="0,4"/><TextBlock Text="✓  Vérifie l’image firmware et son empreinte" Margin="0,4"/><TextBlock Text="✓  N’écrit jamais le bootloader ni les fusibles" Margin="0,4"/><TextBlock Text="✓  Contrôle la réponse du firmware après flash" Margin="0,4"/><Border Background="#352C1A" CornerRadius="10" Padding="12" Margin="0,22,0,0"><TextBlock Text="La première installation nécessite un bootloader Caterina déjà présent sur la carte." TextWrapping="Wrap" Foreground="#E9D49F"/></Border></StackPanel></Border></Grid>
      <Grid x:Name="TestPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width=".85*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,16,0"><StackPanel><DockPanel><StackPanel><TextBlock Text="Contrôle des 12 touches" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="TestInstructions" Text="Connecte un macropad avec DeckPilot firmware." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18"/></StackPanel><Button DockPanel.Dock="Right" Content="Recommencer" Padding="12,7" Click="ResetTest_Click" VerticalAlignment="Top"/></DockPanel><UniformGrid x:Name="KeyGrid" Rows="3" Columns="4" Margin="0,4,0,14"/><TextBlock x:Name="TestHint" Text="Chaque touche doit réussir un appui court et un appui long." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="24"><StackPanel><TextBlock Text="Résultat du contrôle" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ResultTitle" Text="En attente" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{StaticResource Panel2Brush}" CornerRadius="12" Padding="14" Margin="0,0,7,0"><StackPanel><TextBlock Text="COURTS" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ShortCount" Text="0 / 12" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Panel2Brush}" CornerRadius="12" Padding="14" Margin="7,0,0,0"><StackPanel><TextBlock Text="LONGS" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="LongCount" Text="0 / 12" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border></Grid><TextBlock Text="Durée du maintien" FontWeight="SemiBold" Margin="0,22,0,6"/><TextBlock Text="Court : relâcher avant 700 ms. Long : maintenir au moins 700 ms." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><Border Background="#17211E" CornerRadius="12" Padding="14" Margin="0,22,0,0"><StackPanel><TextBlock Text="ACTIVITÉ" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="Activity" Text="En attente d’une touche…" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><Button x:Name="ConnectTestButton" Content="Démarrer le test USB" Background="#186950" BorderBrush="#277C62" Margin="0,22,0,0" Click="ConnectTest_Click"/><Button x:Name="ExportButton" Content="Enregistrer le rapport de contrôle…" Margin="0,10,0,0" Click="ExportButton_Click" IsEnabled="False"/><TextBlock x:Name="TestStatus" Text="Les touches sont lues par USB. L’application n’envoie aucune commande clavier." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border></Grid></Grid>
    <DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock Text="DeckPilot Atelier  ·  outil de préparation indépendant" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="FirmwareVersionLabel" Text="Firmware inclus : —" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right"/></DockPanel>
  </Grid>
</Window>
