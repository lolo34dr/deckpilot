<Window x:Class="DeckPilot.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeckPilot" Width="390" Height="126"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="#14161A"
        Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="DeckPilotSplash"
        AutomationProperties.Name="Démarrage de DeckPilot">
 <Border Margin="1" BorderBrush="#35414A" BorderThickness="1" Padding="20">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Source="/Assets/DeckPilot.png" Width="34" Height="34" Margin="0,0,14,0"
           VerticalAlignment="Center" AutomationProperties.Name="DeckPilot"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="DeckPilot" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="Démarrage…" Foreground="#AAB8C2" Margin="0,4,0,0"/>
    </StackPanel>
    <TextBlock x:Name="VersionText" Grid.Column="2" VerticalAlignment="Center"
               Foreground="#AAB8C2" FontSize="11" Margin="8,0,0,0"/>
   </Grid>
   <ProgressBar x:Name="LoadingProgress" Grid.Row="1" Height="2" Margin="0,14,0,0"
                IsIndeterminate="True" BorderThickness="0" Background="#252A2E"
                Foreground="#9B8CFF" Visibility="Collapsed"/>
  </Grid>
 </Border>
</Window>
