<Window x:Class="DeckPilot.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeckPilot" Width="620" Height="390"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        AllowsTransparency="True" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="DeckPilotSplash">
 <Border Margin="16" CornerRadius="20" Background="#0D0F14"
         BorderBrush="#393B46" BorderThickness="1">
  <Border.Effect>
   <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="0" Opacity="0.55"/>
  </Border.Effect>
  <Grid ClipToBounds="True">
   <Ellipse Width="300" Height="190" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,-105,-75,0" Fill="#34285D" Opacity="0.26">
    <Ellipse.Effect><BlurEffect Radius="48"/></Ellipse.Effect>
   </Ellipse>
   <Grid Margin="28,24,28,22">
    <Grid.RowDefinitions>
     <RowDefinition Height="190"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="#E7EBF1" CornerRadius="14" Padding="10" BorderBrush="#FFFFFF" BorderThickness="1">
     <Image x:Name="SplashBanner" Source="/Assets/DeckPilot-Banner.png"
            Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
            AutomationProperties.AutomationId="SplashBanner"
            AutomationProperties.Name="Bannière DeckPilot"/>
    </Border>
    <StackPanel Grid.Row="1" Margin="2,24,2,0">
     <TextBlock Text="Votre espace DeckPilot se prépare" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="Chargement de vos profils et périphériques…" Foreground="#AEB3C0" FontSize="12" Margin="0,7,0,0"/>
    </StackPanel>
    <Grid Grid.Row="2" Margin="2,22,2,0">
     <Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid>
      <Border x:Name="ReducedMotionProgress" Height="4" CornerRadius="2" Background="#252731">
       <Border Width="48" HorizontalAlignment="Left" CornerRadius="2" Background="#65A5F5"/>
      </Border>
      <ProgressBar x:Name="LoadingProgress" Height="4" IsIndeterminate="True" BorderThickness="0"
                   Background="#252731" Foreground="#65A5F5" Visibility="Collapsed"/>
     </Grid>
     <Grid Grid.Row="1" Margin="0,12,0,0">
      <TextBlock Text="DECKPILOT" Foreground="#8F93A2" FontSize="9" FontWeight="SemiBold"/>
      <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="#8F93A2" FontSize="9"/>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
