<Window x:Class="DeckPilot.Windows.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Mise à jour DeckPilot" Width="470" SizeToContent="Height" ResizeMode="NoResize" Background="#232625" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Une nouvelle version est disponible" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock x:Name="VersionText" Foreground="#A9C6B3" Margin="0,12,0,14"/>
   <TextBlock Text="Voulez-vous mettre à jour DeckPilot ? Le téléchargement et le redémarrage sont automatiques. Vos profils et votre calibrage sont conservés." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
  </StackPanel>
  <TextBlock x:Name="DownloadStatus" Grid.Row="1" Margin="0,20,0,10" TextWrapping="Wrap"/>
  <ProgressBar x:Name="DownloadProgress" Grid.Row="2" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#97B6A2" Background="#363D38" BorderThickness="0"/>
  <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#DFB6A2" TextWrapping="Wrap" Margin="0,12,0,0"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
   <Button x:Name="LaterButton" Content="Plus tard" Click="LaterClick"/>
   <Button x:Name="InstallButton" Content="Mettre à jour" Background="#3E5849" Click="InstallClick" IsDefault="True"/>
  </StackPanel>
 </Grid>
</Window>
