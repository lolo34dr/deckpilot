<UserControl x:ClassModifier="internal" x:Class="DeckPilot.Windows.MacropadCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border x:Name="CardFrame" Background="{DynamicResource CardBrush}"
         BorderThickness="1" CornerRadius="15" Padding="18">
  <Border.Style>
   <Style TargetType="Border"><Setter Property="BorderBrush" Value="#545060"/></Style>
  </Border.Style>
  <StackPanel>
   <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Right" Background="#2D2939" CornerRadius="6" Padding="8,4" VerticalAlignment="Top" Margin="8,0,0,0">
     <TextBlock x:Name="CardPort" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
    </Border>
    <TextBlock x:Name="CardTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
   </DockPanel>
   <TextBlock x:Name="CardStatus" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
   <TextBlock x:Name="CardProgress" Margin="0,12,0,6" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
   <Border Background="#131218" BorderBrush="#373340" BorderThickness="1" CornerRadius="10" Padding="6">
    <UniformGrid x:Name="CardKeys" Rows="3" Columns="4" MaxWidth="440"/>
   </Border>
   <DockPanel Margin="0,12,0,0" LastChildFill="True">
    <Button x:Name="BoardOptionsButton" DockPanel.Dock="Right" Content="Options" Click="OptionsClick"
            MinHeight="40" Margin="8,0,0,0" Padding="9,6"/>
    <Button x:Name="ConfigureButton" Click="ConfigureClick" Style="{StaticResource PrimaryButton}"
            MinHeight="40" Margin="0" Padding="8,6"/>
   </DockPanel>
   <Button x:Name="CalibrateCardButton" Content="Calibrer les touches" Click="CalibrateClick"
           HorizontalAlignment="Left" Margin="0,8,0,0" MinHeight="36"/>
  </StackPanel>
 </Border>
</UserControl>
