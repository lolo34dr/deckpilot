<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DeckPilot.Windows">
 <Style TargetType="local:DeckKeyButton">
  <Setter Property="Width" Value="104"/><Setter Property="Height" Value="96"/>
  <Setter Property="Margin" Value="5"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Foreground" Value="#E8EEF2"/><Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:DeckKeyButton">
   <Border x:Name="KeyBody" CornerRadius="9" BorderThickness="1" BorderBrush="#3C464D" Background="#11161A" Padding="3,3,3,6">
    <Border x:Name="KeyFace" CornerRadius="6" BorderBrush="#323D45" BorderThickness="1" Padding="8,5,8,6">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#273139" Offset="0"/><GradientStop Color="#1C242A" Offset="1"/></LinearGradientBrush></Border.Background>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
      <Border Background="{TemplateBinding AccentBrush}" Width="24" Height="3" CornerRadius="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,0,0"/>
      <Image Source="{TemplateBinding KindSource}" Width="12" Height="14" Opacity="0.9" HorizontalAlignment="Left"/>
      <TextBlock Text="{TemplateBinding KeyCaption}" FontSize="11" Foreground="#A6BAC5" HorizontalAlignment="Right"/>
      <Image Grid.Row="1" Source="{TemplateBinding IconSource}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,2,0,2"/>
      <Border x:Name="StateBadge" Grid.Row="1" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#34473A" Visibility="Collapsed">
       <TextBlock x:Name="StateGlyph" Text="✓" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C5E3CE"/>
      </Border>
      <TextBlock Grid.Row="2" Text="{TemplateBinding Label}" FontSize="12" FontWeight="Medium" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
     </Grid>
    </Border>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="KeyBody" Property="BorderBrush" Value="#83CABA"/><Setter TargetName="KeyFace" Property="Background" Value="#2A393B"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="KeyFace" Property="Background" Value="#304049"/></Trigger>

    <Trigger Property="IsPressed" Value="True"><Setter TargetName="KeyBody" Property="Padding" Value="3,5,3,4"/></Trigger>
    <Trigger Property="IsHardwarePressed" Value="True"><Setter TargetName="KeyBody" Property="Padding" Value="3,5,3,4"/><Setter TargetName="KeyFace" Property="Background" Value="#2E544D"/><Setter TargetName="KeyBody" Property="BorderBrush" Value="#A1DDCF"/></Trigger>
    <Trigger Property="Feedback" Value="{x:Static local:DeckKeyFeedback.Running}"><Setter TargetName="StateBadge" Property="Visibility" Value="Visible"/><Setter TargetName="StateBadge" Property="Background" Value="#38434C"/><Setter TargetName="StateGlyph" Property="Text" Value="…"/><Setter TargetName="StateGlyph" Property="Foreground" Value="#C5D9E8"/><Setter TargetName="KeyBody" Property="BorderBrush" Value="#8EAABD"/></Trigger>
    <Trigger Property="Feedback" Value="{x:Static local:DeckKeyFeedback.Success}"><Setter TargetName="StateBadge" Property="Visibility" Value="Visible"/><Setter TargetName="KeyBody" Property="BorderBrush" Value="#82B892"/></Trigger>
    <Trigger Property="Feedback" Value="{x:Static local:DeckKeyFeedback.Error}"><Setter TargetName="StateBadge" Property="Visibility" Value="Visible"/><Setter TargetName="StateBadge" Property="Background" Value="#5D3533"/><Setter TargetName="StateGlyph" Property="Text" Value="!"/><Setter TargetName="StateGlyph" Property="Foreground" Value="#FFD1C9"/><Setter TargetName="KeyBody" Property="BorderBrush" Value="#D38D80"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="KeyBody" Property="Opacity" Value="0.45"/></Trigger>
    <Trigger Property="IsDropTarget" Value="True"><Setter TargetName="KeyBody" Property="BorderBrush" Value="#A8D7ED"/><Setter TargetName="KeyFace" Property="Background" Value="#344E5C"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
