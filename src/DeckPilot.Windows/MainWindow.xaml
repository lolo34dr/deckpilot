<Window x:Class="DeckPilot.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DeckPilot" Width="1180" Height="850" MinWidth="960" MinHeight="740" Background="#0C111D" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel>
    <TextBlock Text="DECKPILOT" FontSize="13" FontWeight="Bold" Foreground="#93A7FF"/>
    <TextBlock Text="Votre bureau, au bout des doigts." FontSize="27" FontWeight="SemiBold" Margin="0,8,0,6"/>
    <TextBlock Text="12 touches. Vos actions. Votre rythme." Foreground="{StaticResource MutedBrush}"/>
   </StackPanel>
   <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="Recalibrer les touches" Click="CalibrateClick"/>
    <CheckBox x:Name="StartupCheck" Content="Lancer avec Windows" Click="StartupClick"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,24,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="PROFIL ACTIF" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0"/>
    <ComboBox x:Name="ProfilePicker" Width="210" Margin="0" SelectionChanged="ProfileChanged" AutomationProperties.Name="Profil actif"/>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="●  À l’écoute de vos touches" Foreground="#86E5B5" VerticalAlignment="Center"/>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <UniformGrid x:Name="DeckGrid" Rows="4" Columns="3"/>
    <StackPanel Grid.Row="1" Margin="0,12,8,0">
     <TextBlock Text="VOS PROFILS" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
     <TextBox x:Name="ProfileName" MaxLength="60" ToolTip="Nom du profil à créer ou nouveau nom du profil actif" AutomationProperties.Name="Nom du profil" Margin="0,8,0,8"/>
     <WrapPanel>
      <Button Content="Créer" Click="CreateProfile"/>
      <Button Content="Dupliquer" Click="DuplicateProfile"/>
      <Button Content="Renommer" Click="RenameProfile"/>
      <Button Content="Supprimer" Click="DeleteProfile"/>
     </WrapPanel>
    </StackPanel>
   </Grid>
   <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="PERSONNALISER" FontSize="12" Foreground="#93A7FF" FontWeight="Bold"/>
      <TextBlock x:Name="SelectedTitle" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,6"/>
      <TextBlock x:Name="SelectedKey" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20"/>
      <TextBlock Text="Nom du bouton"/>
      <TextBox x:Name="LabelEditor" MaxLength="50" AutomationProperties.Name="Nom du bouton"/>
      <TextBlock Text="Action"/>
      <ComboBox x:Name="ActionPicker" SelectionChanged="ActionChanged" AutomationProperties.Name="Action du bouton"/>
      <TextBlock x:Name="ActionHelp" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
      <StackPanel x:Name="TargetPanel">
       <TextBlock x:Name="TargetLabel"/>
       <TextBox x:Name="TargetEditor" TextWrapping="Wrap" AutomationProperties.Name="Cible de l’action"/>
       <Button x:Name="BrowseButton" Content="Parcourir…" Click="BrowseClick" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel x:Name="ArgumentsPanel">
       <TextBlock Text="Arguments (facultatifs)"/>
       <TextBox x:Name="ArgumentsEditor" AutomationProperties.Name="Arguments du programme"/>
      </StackPanel>
      <StackPanel x:Name="ShortcutPanel">
       <TextBlock Text="Touche du raccourci"/>
       <ComboBox x:Name="ShortcutPicker" DisplayMemberPath="Name" AutomationProperties.Name="Touche du raccourci"/>
       <WrapPanel>
        <CheckBox x:Name="CtrlCheck" Content="Ctrl"/><CheckBox x:Name="AltCheck" Content="Alt"/>
        <CheckBox x:Name="ShiftCheck" Content="Maj"/><CheckBox x:Name="WinCheck" Content="Windows"/>
       </WrapPanel>
      </StackPanel>
      <StackPanel x:Name="MediaPanel">
       <TextBlock Text="Commande multimédia"/>
       <ComboBox x:Name="MediaPicker" DisplayMemberPath="Name" AutomationProperties.Name="Commande multimédia"/>
      </StackPanel>
      <Button Content="Enregistrer l’action" Background="#5267CF" Click="SaveClick" Margin="0,12,0,8" HorizontalContentAlignment="Center"/>
      <TextBlock Text="Les modifications sont aussi enregistrées quand vous changez de touche ou de profil." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,18,0,0">
   <TextBlock x:Name="StatusText" Foreground="#AEBEF4" TextWrapping="Wrap"/>
   <TextBlock Text="Fermer la fenêtre garde DeckPilot actif près de l’horloge. Clic droit sur son icône pour quitter." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <Border x:Name="CalibrationOverlay" Grid.RowSpan="4" Background="#FA0C111D" CornerRadius="16" Visibility="Collapsed" Padding="36">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="Faisons connaissance avec votre clavier." FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="Appuyez sur le bouton physique éclairé à l’écran, de gauche à droite, puis ligne par ligne." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,18"/>
    </StackPanel>
    <TextBlock x:Name="CalibrationPrompt" Grid.Row="1" FontSize="18" Margin="0,0,0,14" TextWrapping="Wrap"/>
    <UniformGrid x:Name="CalibrationGrid" Grid.Row="2" Rows="4" Columns="3"/>
    <StackPanel Grid.Row="3" Margin="0,18,0,0">
     <TextBlock x:Name="CalibrationError" Foreground="#FFD28D" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <WrapPanel><Button Content="Recommencer" Click="RestartCalibration"/><Button Content="Annuler" Click="CancelCalibration"/></WrapPanel>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
