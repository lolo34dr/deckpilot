<Window x:Class="DeckPilot.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="/Assets/DeckPilot.png" Title="DeckPilot" Width="1180" Height="900" MinWidth="960" MinHeight="720" Background="#181C20" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen">
 <Grid x:Name="WindowContent">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="DeckEditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
   <Grid MinWidth="550" Width="{Binding ViewportWidth, ElementName=DeckEditorScroll}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="24,22,24,20">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,16">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal">
        <Image Source="/Assets/DeckPilot.png" Width="30" Height="30" Margin="0,0,10,0"/>
        <TextBlock VerticalAlignment="Center" Text="DeckPilot" FontWeight="SemiBold" FontSize="21"/>
        <Border Background="#263C3B" CornerRadius="5" Padding="7,3" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Foreground="#98D6CB" FontSize="10" FontWeight="SemiBold"/></Border>
       </StackPanel>
       <Button Grid.Column="1" Content="Bibliothèque" Click="FocusActionSearchClick" Margin="12,0,0,0" Padding="12,7" ToolTip="Rechercher une action ou une application (Ctrl+K)" AutomationProperties.AutomationId="FocusActionSearchButton"/>
      </Grid>
      <Grid Grid.Row="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="Profil actif" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <ComboBox x:Name="ProfilePicker" Grid.Column="1" Width="280" HorizontalAlignment="Left" Margin="0" SelectionChanged="ProfileChanged" AutomationProperties.Name="Profil actif"/>
       <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
        <Button x:Name="UndoProfileButton" Content="↶" Click="UndoProfileClick" Margin="0,0,5,0" Padding="11,4" FontSize="17" ToolTip="Annuler la dernière modification des profils (Ctrl+Z hors des champs de texte)." AutomationProperties.Name="Annuler une modification"/>
        <Button x:Name="RedoProfileButton" Content="↷" Click="RedoProfileClick" Margin="0" Padding="11,4" FontSize="17" ToolTip="Rétablir (Ctrl+Y hors des champs de texte)." AutomationProperties.Name="Rétablir une modification"/>
       </StackPanel>
      </Grid>
      <TextBlock x:Name="ProfileSummary" Grid.Row="2" Text="12 touches · Un espace pour chaque usage" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
     </Grid>
     <Border x:Name="DeckSurface" Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Center" Width="490" CornerRadius="16" BorderThickness="1" BorderBrush="#384348" Padding="16,12,16,12">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#272E32" Offset="0"/><GradientStop Color="#1C2226" Offset="1"/></LinearGradientBrush></Border.Background>

      <StackPanel>
       <Grid Margin="6,0,6,10">
        <TextBlock Text="VOTRE DECK / 3 × 4" FontSize="11" FontWeight="SemiBold" Foreground="#A5B4BC" VerticalAlignment="Center"/>
        <Border x:Name="DeckConnectionPill" Background="#363C37" CornerRadius="9" Padding="8,3" HorizontalAlignment="Right">
         <StackPanel Orientation="Horizontal"><Ellipse x:Name="DeckConnectionDot" Width="5" Height="5" Fill="#ADB6AF" Margin="0,0,6,0"/><TextBlock x:Name="DeckAvailabilityStatus" Text="Recherche…" FontSize="11" Foreground="#C8D1CA" AutomationProperties.AutomationId="DeckAvailabilityStatus"/></StackPanel>
        </Border>
       </Grid>
       <UniformGrid x:Name="DeckGrid" Rows="3" Columns="4" Width="456" Height="318"/>
       <TextBlock x:Name="DeckAvailabilityHint" Text="Vos profils restent modifiables pendant la connexion." FontSize="12" Foreground="#ADBAC2" Margin="6,10,6,0" TextWrapping="Wrap" AutomationProperties.AutomationId="DeckAvailabilityHint"/>
      </StackPanel>
     </Border>

    </Grid>
    <Border x:Name="EditorPanel" Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Background="#20262B" Padding="20" Margin="24,0,24,24">
      <StackPanel>
       <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
         <TextBlock x:Name="SelectedTitle" FontSize="16" FontWeight="SemiBold"/>
         <TextBlock x:Name="SelectedKey" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#293637" CornerRadius="5" Padding="8,5" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="EditorActionTitle" MaxWidth="175" TextWrapping="Wrap" Foreground="#ACD4CD" FontSize="11"/></Border>
       </Grid>
       <ComboBox x:Name="ActionPicker" Visibility="Collapsed" SelectionChanged="ActionChanged"/>
       <CheckBox x:Name="LongPressCheck" Content="Deux actions : appui court et appui long" Click="LongPressClick"/>
       <StackPanel x:Name="GesturePanel" Visibility="Collapsed" Margin="0,0,0,8">
        <TextBlock Text="L’appui court attend le relâchement ; l’appui long le remplace au seuil choisi." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
        <ComboBox x:Name="GesturePicker" SelectionChanged="GestureChanged" AutomationProperties.Name="Action à configurer"/>
        <TextBlock Text="{Binding ElementName=LongPressThreshold, Path=Value, StringFormat='Seuil : {0:0} ms'}" Foreground="{StaticResource MutedBrush}"/>
        <Slider x:Name="LongPressThreshold" Minimum="200" Maximum="3000" Value="600" TickFrequency="50" IsSnapToTickEnabled="True" SmallChange="50" LargeChange="200" Width="260" HorizontalAlignment="Left" Margin="0,8,0,8" AutomationProperties.Name="Seuil d’appui long en millisecondes"/>
       </StackPanel>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,14,0"><TextBlock Text="Nom de la touche" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="LabelEditor" MaxLength="50" AutomationProperties.Name="Nom du bouton"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Couleur de la touche" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox x:Name="AccentPicker" DisplayMemberPath="Name" AutomationProperties.Name="Couleur de la touche"/></StackPanel>
       </Grid>
       <StackPanel x:Name="ApplicationPanel" Margin="0,0,0,10">
        <Button AutomationProperties.AutomationId="ChooseApplication" AutomationProperties.Name="Choisir une application" Click="ChooseApplicationClick" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,0,0,8" Background="#303C34" BorderBrush="#4F6858">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image x:Name="SelectedApplicationIcon" Width="25" Height="25" HorizontalAlignment="Left"/>
          <StackPanel Grid.Column="1"><TextBlock Text="Choisir une application" FontWeight="SemiBold"/><TextBlock x:Name="SelectedApplicationName" Foreground="#B0C0B5" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <TextBlock Grid.Column="2" Text="›" FontSize="22" Foreground="#A7B8AD" VerticalAlignment="Center" Margin="10,0,0,0"/>
         </Grid>
        </Button>
       </StackPanel>
       <Expander x:Name="AdvancedOptionsExpander" Foreground="#A7B2AB" Header="Options avancées" Margin="0,0,0,10" IsExpanded="False" AutomationProperties.AutomationId="AdvancedOptionsExpander">
       <StackPanel>
       <StackPanel x:Name="TargetPanel" Margin="0,10,0,0">
        <TextBlock x:Name="TargetLabel" Foreground="{StaticResource MutedBrush}"/>
        <DockPanel>
         <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseClick" VerticalAlignment="Top" Margin="8,5,0,12"/>
         <TextBox x:Name="TargetEditor" TextChanged="TargetChanged" AutomationProperties.Name="Cible de l’action"/>
        </DockPanel>
       </StackPanel>
       <StackPanel x:Name="ArgumentsPanel" Margin="0,0,0,10">
        <TextBlock Text="Arguments (facultatifs)" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="ArgumentsEditor" AutomationProperties.Name="Arguments du programme"/>
       </StackPanel>
       </StackPanel>
       </Expander>
       <StackPanel x:Name="ProfileActionPanel" Visibility="Collapsed">
        <TextBlock Text="Profil à activer" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="ProfileTargetPicker" DisplayMemberPath="Name" AutomationProperties.Name="Profil à activer"/>
       </StackPanel>
       <StackPanel x:Name="SystemActionPanel" Visibility="Collapsed">
        <TextBlock Text="Action Windows" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="SystemCommandPicker" DisplayMemberPath="Name" AutomationProperties.Name="Action Windows"/>
       </StackPanel>
       <StackPanel x:Name="ShortcutPanel">
        <Button x:Name="RecordShortcutButton" Content="Enregistrer un raccourci" Click="RecordShortcutClick" HorizontalAlignment="Left" Margin="0,0,0,6" ToolTip="Appuyez sur la combinaison à affecter à cette touche."/>
        <TextBlock x:Name="ShortcutRecordingHint" Text="Ou choisissez la touche et ses modificateurs ci-dessous." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Text="Touche du raccourci" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="ShortcutPicker" DisplayMemberPath="Name" AutomationProperties.Name="Touche du raccourci"/>
        <WrapPanel><CheckBox x:Name="CtrlCheck" Content="Ctrl"/><CheckBox x:Name="AltCheck" Content="Alt"/><CheckBox x:Name="ShiftCheck" Content="Maj"/><CheckBox x:Name="WinCheck" Content="Windows"/></WrapPanel>
       </StackPanel>
       <StackPanel x:Name="MediaPanel">
        <TextBlock Text="Commande multimédia" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="MediaPicker" DisplayMemberPath="Name" AutomationProperties.Name="Commande multimédia"/>
       </StackPanel>
       <StackPanel x:Name="SpotifyPanel" Visibility="Collapsed">
        <TextBlock Text="Commande Spotify" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="SpotifyPicker" DisplayMemberPath="Name" AutomationProperties.Name="Commande Spotify"/>
       </StackPanel>
       <StackPanel x:Name="AudioOutputPanel" Visibility="Collapsed">
        <TextBlock Text="Première sortie audio" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="PrimaryOutputPicker" DisplayMemberPath="Name" AutomationProperties.Name="Première sortie audio"/>
        <TextBlock Text="Seconde sortie audio" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="SecondaryOutputPicker" DisplayMemberPath="Name" AutomationProperties.Name="Seconde sortie audio"/>
       </StackPanel>
       <TextBlock x:Name="ActionHelp" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <WrapPanel>
        <Button x:Name="SaveActionButton" Style="{StaticResource PrimaryButton}" Content="Enregistrer" Click="SaveClick" Padding="18,7" ToolTip="Les changements sont aussi enregistrés en changeant de touche ou de profil."/>
        <Button x:Name="TestActionButton" Content="Tester l’action" Click="TestActionClick" Padding="16,7" AutomationProperties.AutomationId="TestActionButton" ToolTip="Enregistre et exécute cette action sur ce PC, même sans la carte."/>
       </WrapPanel>
       <TextBlock x:Name="ActionExecutionStatus" Text="" Foreground="#A8B6AC" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" AutomationProperties.AutomationId="ActionExecutionStatus"/>
      </StackPanel>
    </Border>
   </Grid>
   </ScrollViewer>
   <Border Grid.Column="1" Background="#1D2328" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="18,22,14,16">
    <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
     <StackPanel>
       <TextBlock Text="Bibliothèque d’actions" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="Cliquez pour configurer, glissez pour affecter." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,8"/>
       <TextBlock Text="Rechercher" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
       <TextBox x:Name="ActionSearchBox" TextChanged="ActionSearchChanged" AutomationProperties.Name="Rechercher une action ou une application" ToolTip="Exemples : volume, Spotify, Discord ou le nom d’une application."/>
       <TextBlock x:Name="ActionSearchStatus" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <StackPanel x:Name="ActionCatalog"/>
       <StackPanel x:Name="ActionSearchResults" Visibility="Collapsed"/>
       <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,16"/>
       <Border Background="#242C31" BorderBrush="#364149" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
        <StackPanel>
         <TextBlock Text="Votre macropad" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <TextBlock x:Name="BoardConnectionStatus" Text="Recherche du macropad…" TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#A8C4AF" AutomationProperties.AutomationId="BoardConnectionStatus"/>
         <TextBlock x:Name="BoardFirmwareStatus" Text="Vérification du firmware…" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
         <Button x:Name="FirmwareButton" Content="Firmware du macropad…" AutomationProperties.AutomationId="OpenFirmware" Click="FirmwareClick" HorizontalAlignment="Stretch" FontSize="11" Margin="0,8,0,6"/>
         <Expander x:Name="BoardDiagnosticExpander" Header="Connexion et diagnostic" FontSize="11" Foreground="#C1CDC4">
          <StackPanel Margin="0,6,0,0">
           <ComboBox x:Name="BoardDevicePicker" SelectionChanged="BoardDeviceChanged" Visibility="Collapsed" Margin="0,4,0,0" AutomationProperties.AutomationId="BoardDevicePicker"/>
           <TextBlock x:Name="BoardLinkDetails" Foreground="#A4ADA6" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,6"/>
           <CheckBox x:Name="AutoFirmwareCheck" Click="AutoFirmwareClick" Margin="0,6,0,6"><TextBlock Text="Proposer les mises à jour du firmware" FontSize="11" TextWrapping="Wrap"/></CheckBox>
           <Button Content="Copier le diagnostic" Click="CopyDiagnosticClick" HorizontalAlignment="Left" FontSize="11"/>
          </StackPanel>
         </Expander>
        </StackPanel>
       </Border>
       <Border Background="#242C31" BorderBrush="#364149" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
        <StackPanel>
         <TextBlock Text="Audio Windows" FontWeight="SemiBold" Margin="0,0,0,6"/>
         <TextBlock x:Name="MicrophoneStatus" Text="Recherche des micros…" TextWrapping="Wrap" AutomationProperties.AutomationId="MicrophoneStatus"/>
         <Button x:Name="MicrophoneToggleButton" Content="Couper les micros" Click="ToggleMicrophoneClick" IsEnabled="False" Margin="0,8,0,6"/>
         <TextBlock x:Name="CurrentAudioOutput" Text="Lecture de la sortie audio…" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
       <Expander x:Name="ProfilesExpander" Foreground="#D2D2D2" Header="Gérer les profils" IsExpanded="False">
        <StackPanel Margin="0,12,0,0">
         <TextBlock Text="Nom du profil" Foreground="{StaticResource MutedBrush}"/>
         <TextBox x:Name="ProfileName" MaxLength="60" ToolTip="Nom du profil à créer ou nouveau nom du profil actif" AutomationProperties.Name="Nom du profil"/>
         <WrapPanel><Button Content="Créer" Click="CreateProfile"/><Button Content="Dupliquer" Click="DuplicateProfile"/><Button Content="Renommer" Click="RenameProfile"/><Button Content="Supprimer" Click="DeleteProfile"/></WrapPanel>
         <WrapPanel><Button x:Name="ImportProfilesButton" Content="Importer…" Click="ImportProfilesClick"/><Button x:Name="ExportProfileButton" Content="Exporter ce profil…" Click="ExportProfileClick"/></WrapPanel>
         <Button x:Name="ExportAllProfilesButton" Content="Exporter tous les profils…" Click="ExportAllProfilesClick" HorizontalAlignment="Left"/>
         <Button x:Name="RestoreProfilesButton" Content="Restaurer une sauvegarde…" Click="RestoreProfilesClick" HorizontalAlignment="Left"/>
         <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,12"/>
         <TextBlock Text="Partir d’un modèle" FontWeight="SemiBold"/>
         <TextBlock Text="Ajoute un nouveau profil prêt à personnaliser." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,2"/>
         <ComboBox x:Name="ProfileTemplatePicker" DisplayMemberPath="Name" AutomationProperties.Name="Modèle de profil"/>
         <Button x:Name="AddTemplateButton" Content="Ajouter le modèle" Click="AddTemplateClick" HorizontalAlignment="Left"/>
         <TextBlock Text="20 sauvegardes automatiques des profils, avant chaque modification enregistrée. Le calibrage reste sur ce PC." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        </StackPanel>
       </Expander>

      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
      <Expander x:Name="PreferencesExpander" Header="Préférences de l’application" Foreground="#C1CDC4" IsExpanded="False" AutomationProperties.AutomationId="ApplicationPreferences">
       <StackPanel Margin="0,10,0,0">
      <TextBlock Text="Apparence" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <CheckBox x:Name="ReduceMotionCheck" Content="Réduire les animations" Click="ReduceMotionClick"/>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,12"/>
      <TextBlock Text="Mises à jour" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <CheckBox x:Name="AutoUpdateCheck" Content="Rechercher automatiquement" Click="AutoUpdateClick"/>
      <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <Button x:Name="UpdateCheckButton" Content="Vérifier maintenant" Click="CheckUpdateClick" HorizontalAlignment="Left"/>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,12"/>
      <CheckBox x:Name="StartupCheck" Content="Lancer avec Windows" Click="StartupClick"/>
      <TextBlock x:Name="StartupStatus" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
       </StackPanel>
      </Expander>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,12"/>
      <Expander x:Name="ActivityExpander" Header="Activité récente" Margin="0,0,0,8">
       <StackPanel Margin="0,8,0,0">
        <StackPanel x:Name="ActivityList"/>
        <Button Content="Effacer l’historique" Click="ClearActivityClick" HorizontalAlignment="Left" FontSize="11" Margin="0,8,0,0"/>
       </StackPanel>
      </Expander>
      <Button x:Name="CalibrateButton" Content="Calibrer les touches" Click="CalibrateClick" HorizontalAlignment="Left"/>
      <TextBlock Text="Fermer la fenêtre garde DeckPilot actif près de l’horloge." Foreground="#B9C4BC" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>

     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="#151A1E" Padding="16,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Foreground="#BBC5BE" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <TextBlock x:Name="HeaderMicrophoneStatus" Grid.Column="1" Text="Micro : lecture de l’état…" FontSize="11" Foreground="#BAC4BD" VerticalAlignment="Center" Margin="12,0,0,0"/>
   </Grid>
  </Border>
  <Border x:Name="CalibrationOverlay" Grid.RowSpan="2" Background="#181C20" Visibility="Collapsed" Padding="32">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="Calibrage des touches" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="Appuyez sur le bouton physique indiqué, de gauche à droite, puis ligne par ligne." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,20"/>
    </StackPanel>
    <TextBlock x:Name="CalibrationPrompt" Grid.Row="1" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap"/>
    <UniformGrid x:Name="CalibrationGrid" Grid.Row="2" Rows="3" Columns="4" Width="384" Height="288" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <StackPanel Grid.Row="3" Margin="0,16,0,0">
     <TextBlock x:Name="CalibrationError" Foreground="#C4B494" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <WrapPanel><Button Content="Recommencer" Click="RestartCalibration"/><Button Content="Annuler" AutomationProperties.AutomationId="CancelCalibration" Click="CancelCalibration"/></WrapPanel>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
