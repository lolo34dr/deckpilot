<Window x:Class="DeckPilot.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DeckPilot" Width="1000" Height="820" MinWidth="880" MinHeight="720" Background="#262626" FontFamily="Segoe UI" FontSize="12" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="436"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="24,16,24,12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <StackPanel>
       <TextBlock Text="DeckPilot" FontWeight="SemiBold" FontSize="14"/>
       <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
        <TextBlock Text="Profil" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox x:Name="ProfilePicker" Width="190" Margin="0" SelectionChanged="ProfileChanged" AutomationProperties.Name="Profil actif"/>
       </StackPanel>
      </StackPanel>
      <TextBlock Text="F13 – F24" Foreground="#898989" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"/>
     </Grid>
     <UniformGrid x:Name="DeckGrid" Grid.Row="1" Rows="4" Columns="3" Width="258" Height="344" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    </Grid>
    <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="#242424" Padding="24,16,24,12">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,0">
       <Grid Margin="0,0,0,14">
        <StackPanel>
         <TextBlock x:Name="SelectedTitle" FontSize="14" FontWeight="SemiBold"/>
         <TextBlock x:Name="SelectedKey" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>
        <TextBlock x:Name="EditorActionTitle" Foreground="#B8B8B8" HorizontalAlignment="Right" VerticalAlignment="Top"/>
       </Grid>
       <ComboBox x:Name="ActionPicker" Visibility="Collapsed" SelectionChanged="ActionChanged"/>
       <TextBlock Text="Nom" Foreground="{StaticResource MutedBrush}"/>
       <TextBox x:Name="LabelEditor" MaxLength="50" AutomationProperties.Name="Nom du bouton"/>
       <StackPanel x:Name="TargetPanel">
        <TextBlock x:Name="TargetLabel" Foreground="{StaticResource MutedBrush}"/>
        <DockPanel>
         <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseClick" VerticalAlignment="Top" Margin="8,5,0,12"/>
         <TextBox x:Name="TargetEditor" AutomationProperties.Name="Cible de l’action"/>
        </DockPanel>
       </StackPanel>
       <StackPanel x:Name="ArgumentsPanel">
        <TextBlock Text="Arguments (facultatifs)" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="ArgumentsEditor" AutomationProperties.Name="Arguments du programme"/>
       </StackPanel>
       <StackPanel x:Name="ShortcutPanel">
        <TextBlock Text="Touche du raccourci" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="ShortcutPicker" DisplayMemberPath="Name" AutomationProperties.Name="Touche du raccourci"/>
        <WrapPanel><CheckBox x:Name="CtrlCheck" Content="Ctrl"/><CheckBox x:Name="AltCheck" Content="Alt"/><CheckBox x:Name="ShiftCheck" Content="Maj"/><CheckBox x:Name="WinCheck" Content="Windows"/></WrapPanel>
       </StackPanel>
       <StackPanel x:Name="MediaPanel">
        <TextBlock Text="Commande multimédia" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="MediaPicker" DisplayMemberPath="Name" AutomationProperties.Name="Commande multimédia"/>
       </StackPanel>
       <TextBlock x:Name="ActionHelp" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <Button Content="Enregistrer" Click="SaveClick" HorizontalAlignment="Left" Padding="18,7" ToolTip="Les changements sont aussi enregistrés en changeant de touche ou de profil."/>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>
   <Border Grid.Column="1" Background="#222222" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="16,20,16,12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Bottom">
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
      <CheckBox x:Name="StartupCheck" Content="Lancer avec Windows" Click="StartupClick"/>
      <Button Content="Calibrer les touches" Click="CalibrateClick" HorizontalAlignment="Left"/>
      <TextBlock Text="Fermer la fenêtre garde DeckPilot actif près de l’horloge." Foreground="#8E8E8E" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,4,0">
       <TextBlock Text="Actions" FontSize="13" FontWeight="SemiBold"/>
       <TextBlock Text="Choisissez une touche, puis une action." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,16"/>
       <StackPanel x:Name="ActionCatalog"/>
       <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,16"/>
       <Expander Foreground="#D2D2D2" Header="Gérer les profils" IsExpanded="False">
        <StackPanel Margin="0,12,0,0">
         <TextBlock Text="Nom du profil" Foreground="{StaticResource MutedBrush}"/>
         <TextBox x:Name="ProfileName" MaxLength="60" ToolTip="Nom du profil à créer ou nouveau nom du profil actif" AutomationProperties.Name="Nom du profil"/>
         <WrapPanel><Button Content="Créer" Click="CreateProfile"/><Button Content="Dupliquer" Click="DuplicateProfile"/><Button Content="Renommer" Click="RenameProfile"/><Button Content="Supprimer" Click="DeleteProfile"/></WrapPanel>
        </StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="#202020" Padding="12,0">
   <TextBlock x:Name="StatusText" Foreground="#A0A0A0" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Border>
  <Border x:Name="CalibrationOverlay" Grid.RowSpan="2" Background="#262626" Visibility="Collapsed" Padding="32">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="Calibrage des touches" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="Appuyez sur le bouton physique indiqué, de gauche à droite, puis ligne par ligne." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,20"/>
    </StackPanel>
    <TextBlock x:Name="CalibrationPrompt" Grid.Row="1" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap"/>
    <UniformGrid x:Name="CalibrationGrid" Grid.Row="2" Rows="4" Columns="3" Width="288" Height="384" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <StackPanel Grid.Row="3" Margin="0,16,0,0">
     <TextBlock x:Name="CalibrationError" Foreground="#C4B494" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <WrapPanel><Button Content="Recommencer" Click="RestartCalibration"/><Button Content="Annuler" Click="CancelCalibration"/></WrapPanel>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
